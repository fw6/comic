{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@lynx-js/types"]
  },
  // 仅编译入口 index.ts：codegen 生成的逐方法 .ts 实现不完整（类型残缺），
  // 其类型定义（.d.ts）仍由 index.ts 以 import type 引用。
  "include": ["index.ts"]
}
